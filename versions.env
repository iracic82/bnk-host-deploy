# Single source of truth for every pinned version. Everything that installs anything reads this
# file: install.sh, the CI workflows, the runner image and the Forge module. Change a version here,
# open a pull request, and the plan job shows you what the change does before anything is applied.

# --- BNK release ---------------------------------------------------------------------------------
# 2.4.2: the newest release manifest on repo.f5.com when this was pinned (tags 2.4.0, 2.4.1, 2.4.2).
# A critical release on top of 2.4.1 (CVE fixes, no feature change). The component versions below
# are read out of release/f5-bigip-k8s-manifest 2.4.2, not copied from the docs, because the install
# guide tells you to grep them out at install time, which is not reproducible.
BNK_VERSION=2.4.2
CNE_REPO=repo.f5.com
# The short tag. The registry carries both short and long tags; only the short one is what the 2.4
# operator resolves. With the long form it logs "Unable to retrieve remote manifest" and the
# CNEInstance sits at Reconciled=False with no other error anywhere.
CNE_RELEASE_MANIFEST=2.4.2
FLO_VERSION=v2.30.0-0.11.4                          # charts/f5-lifecycle-operator, from the manifest
CERT_GEN_VERSION=0.9.3                              # utils/f5-cert-gen, from the manifest
TMM_CHART_VERSION=15.1016.2-0.8.3                   # charts/f5-tmm, informational (FLO installs it)

# --- cluster prerequisites -----------------------------------------------------------------------
# BNK 2.4.x host mode is qualified on Kubernetes 1.35. Preflight warns on any other minor.
K8S_MINOR=1.35
CALICO_VERSION=v3.32.2
CERT_MANAGER_VERSION=v1.16.2
# Gateway API Inference Extension (InferencePool CRDs). Installed by phase 47 only when a cluster file
# sets inference.epp_namespaces. BNK 2.4 endpoint pickers are tested with this release.
GAIE_VERSION=v1.4.0
MULTUS_VERSION=v4.2.0
MULTUS_MEMORY_LIMIT=512Mi                           # BNK floods Multus; the default limit OOMKills

# --- install targets -----------------------------------------------------------------------------
NS_CORE=f5-cne-core                                 # FLO, CWC, licensing
NS_BNK=f5-bnk                                       # the CNEInstance and everything it creates
CLUSTER_ISSUER=f5-cne-internal-ca
CA_COMMON_NAME=f5-cne-internal-ca-root              # MUST differ from leaf CNs or CWC fails x509

# --- tooling, pinned so local runs, CI and the runner image behave identically --------------------
KUBECTL_VERSION=v1.35.0
HELM_VERSION=v3.19.0
YQ_VERSION=v4.47.2
SHELLCHECK_VERSION=v0.11.0
