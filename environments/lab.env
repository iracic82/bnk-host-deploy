# Lab: throwaway clusters, training sandboxes, CI. Licensed, but forgiving: warnings stay warnings.
BNK_ENV_NAME=lab
BNK_DEPLOYMENT_SIZE=Small
BNK_STORAGECLASS=standard
BNK_POD_CIDR=192.168.0.0/16
BNK_LICENSE_MODE=connected
BNK_CORE_COLLECTION=false
BNK_REQUIRE_LICENSE=true
BNK_STRICT_PREFLIGHT=false
# A lab is usually the coldest cluster you will ever install on: nothing in the image cache and ~80
# components to pull. Short timeouts belong to warm clusters, not small ones.
BNK_WAIT_TIMEOUT=2400
