# Staging: production-shaped, so every preflight warning is fatal here too. If staging passes,
# production sees no surprises.
BNK_ENV_NAME=staging
BNK_DEPLOYMENT_SIZE=Small
BNK_STORAGECLASS=standard
BNK_POD_CIDR=192.168.0.0/16
BNK_LICENSE_MODE=connected
BNK_CORE_COLLECTION=false
BNK_REQUIRE_LICENSE=true
BNK_STRICT_PREFLIGHT=true
BNK_WAIT_TIMEOUT=1800
