#!/usr/bin/env bash
[ -n "${BASH_ENV:-}${ENV:-}" ] && echo "note: runner set BASH_ENV=${BASH_ENV:-} ENV=${ENV:-}, unset for child scripts" >&2
unset BASH_ENV ENV
# Path not taken: BNK is already installed by another path and this path's tool does not own it.
# Skipping this challenge then takes seconds, and the cluster and its owner stay as they are.
export PATH=/usr/local/bin:$PATH KUBECONFIG=/root/.kube/config
source /opt/lab/lib.sh
_owner=$(gitea_api GET "/repos/${GITEA_ORG}/${GITEA_REPO}/actions/variables/BNK_INSTALLER" 2>/dev/null | jq -r '.data // .value // empty' || true)
_avail=$(kubectl -n f5-bnk get cneinstance f5-bnk-instance -o jsonpath='{.status.conditions[?(@.type=="Available")].status}' 2>/dev/null || true)
if [[ "$_avail" == True && -n "$_owner" && "$_owner" != forge ]]; then echo "path not taken: BNK installed by $_owner"; exit 0; fi
set -uo pipefail
source /opt/lab/lib.sh
curl -fsSk -o /dev/null https://127.0.0.1:8443/api/system/health || { fail-message "Forge is not running. Run 'lab forge' (step 1)."; exit 1; }
forge_api GET /api/blueprint-catalog/releases 2>/dev/null | jq -e '[.[]? | select(.blueprint_id=="bnk-host-2-4" and .release_state=="imported")] | length > 0' >/dev/null \
  || { fail-message "The blueprint 'BNK 2.4.2 Host on an existing cluster' is not imported yet (step 3)."; exit 1; }
pid=$(forge_api GET /api/projects | jq -r '(if type=="array" then . else (.items // .sources // .projects // .clusters // .modules // .secrets // []) end)[] | select(.name=="bnk-lab") | .id' | head -1)
[[ -n "$pid" ]] || { fail-message "No Forge project named bnk-lab yet (step 4)."; exit 1; }
n=$(forge_api GET "/api/projects/${pid}/secrets" | jq -r '[(if type=="array" then . else (.items // .sources // .projects // .clusters // .modules // .secrets // []) end)[].name] | map(select(. == "kubeconfig" or . == "far_service_account_key" or . == "bnk_license_jwt")) | length')
[[ "$n" == 3 ]] || { fail-message "Project bnk-lab has $n of its 3 secrets. Run 'lab forge-secrets bnk-lab'."; exit 1; }
exit 0
