#!/usr/bin/env bash
[ -n "${BASH_ENV:-}${ENV:-}" ] && echo "note: runner set BASH_ENV=${BASH_ENV:-} ENV=${ENV:-}, unset for child scripts" >&2
unset BASH_ENV ENV
set -euxo pipefail
export PATH=/usr/local/bin:$PATH KUBECONFIG=/root/.kube/config
source /opt/lab/lib.sh
lab forge
lab forge-catalog
rid=$(forge_api GET /api/blueprint-catalog/releases | jq -r '[.[]? | select(.blueprint_id=="bnk-host-2-4" and .release_state=="imported")] | sort_by(.id) | last | .id')
pid=$(forge_api GET /api/projects | jq -r '(if type=="array" then . else (.items // .sources // .projects // .clusters // .modules // .secrets // []) end)[] | select(.name=="bnk-lab") | .id' | head -1)
[[ -n "$pid" ]] || forge_api POST "/api/stacks/releases/${rid}/projects" '{"name":"bnk-lab","environment":"lab","variables":{"tmm_node":"bnk-worker","cluster_name":"lab"}}' >/dev/null
lab forge-secrets bnk-lab
