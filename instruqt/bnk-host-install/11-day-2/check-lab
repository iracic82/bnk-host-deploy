#!/usr/bin/env bash
[ -n "${BASH_ENV:-}${ENV:-}" ] && echo "note: runner set BASH_ENV=${BASH_ENV:-} ENV=${ENV:-}, unset for child scripts" >&2
unset BASH_ENV ENV
set -uo pipefail
r=$(kubectl -n hello get deploy hello -o jsonpath='{.status.readyReplicas}' 2>/dev/null)
[[ "${r:-0}" -ge 5 ]] || { fail-message "hello has ${r:-0} ready replicas; merge the 'apps/hello: 5 replicas' pull request (step 5)."; exit 1; }
seen=$(for _ in $(seq 1 30); do docker exec client curl -s -m 3 http://10.30.30.10/ 2>/dev/null | sed -n 's/^Hostname: //p'; done | sort -u | wc -l)
[[ "$seen" -ge 4 ]] || { fail-message "Only $seen different hello pods answered through BNK; give TMM a few seconds to add the new pods and try again."; exit 1; }
exit 0
