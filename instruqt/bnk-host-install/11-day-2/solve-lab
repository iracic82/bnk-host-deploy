#!/usr/bin/env bash
[ -n "${BASH_ENV:-}${ENV:-}" ] && echo "note: runner set BASH_ENV=${BASH_ENV:-} ENV=${ENV:-}, unset for child scripts" >&2
unset BASH_ENV ENV
set -euxo pipefail
export PATH=/usr/local/bin:$PATH KUBECONFIG=/root/.kube/config
source /opt/lab/lib.sh; source /opt/lab/ci-helpers.sh
lab forge-ready
lab plan >/dev/null 2>&1 || true
cd "$WORKSPACE"; git checkout -q main; git pull -q
if ! grep -q 'replicas: 5' apps/hello/hello.yaml; then
  git checkout -q -B hello-five; sed -i 's/replicas: 3/replicas: 5/' apps/hello/hello.yaml
  git commit -qam "apps/hello: 5 replicas"; git push -q -f -u origin hello-five
  merge_pr "$(open_pr hello-five 'apps/hello: 5 replicas')"; git checkout -q main; git pull -q
fi
kubectl apply -f apps/hello/hello.yaml >/dev/null
kubectl -n hello rollout status deploy/hello --timeout=300s
sleep 30
