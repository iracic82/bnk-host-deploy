#!/usr/bin/env bash
[ -n "${BASH_ENV:-}${ENV:-}" ] && echo "note: runner set BASH_ENV=${BASH_ENV:-} ENV=${ENV:-}, unset for child scripts" >&2
unset BASH_ENV ENV
set -euxo pipefail
export PATH=/usr/local/bin:$PATH KUBECONFIG=/root/.kube/config
source /opt/lab/lib.sh; source /opt/lab/ci-helpers.sh
lab image
cd "$WORKSPACE"
git checkout -q -B pin-runner-image
git commit -qam "runner: pin the installer image built in this lab" || true
git push -q -f -u origin pin-runner-image
sha=$(git rev-parse HEAD)
n=$(open_pr pin-runner-image "Pin the installer image")
echo "PR #$n, waiting for ci"
echo "ci: $(wait_run ci.yml "$sha" 900 || true)"
merge_pr "$n"
git checkout -q main && git pull -q
