#!/usr/bin/env bash
[ -n "${BASH_ENV:-}${ENV:-}" ] && echo "note: runner set BASH_ENV=${BASH_ENV:-} ENV=${ENV:-}, unset for child scripts" >&2
unset BASH_ENV ENV
# Path not taken: BNK is installed by another path, so there is nothing to check here.
export PATH=/usr/local/bin:$PATH KUBECONFIG=/root/.kube/config
source /opt/lab/lib.sh
_owner=$(gitea_api GET "/repos/${GITEA_ORG}/${GITEA_REPO}/actions/variables/BNK_INSTALLER" 2>/dev/null | jq -r '.data // .value // empty' || true)
_avail=$(kubectl -n f5-bnk get cneinstance f5-bnk-instance -o jsonpath='{.status.conditions[?(@.type=="Available")].status}' 2>/dev/null || true)
if [[ "$_avail" == True && -n "$_owner" && "$_owner" != pipeline ]]; then echo "path not taken: BNK installed by $_owner"; exit 0; fi
set -uo pipefail
source /opt/lab/lib.sh; source /opt/lab/ci-helpers.sh
[[ "$(gitea_api GET "${REPO_PATH}/actions/variables/BNK_INSTALLER" 2>/dev/null | jq -r '.data // .value // empty')" == pipeline ]] \
  || { fail-message "The repository is not set up for the pipeline path. Run 'lab ci-secrets' (step 1)."; exit 1; }
# The newest pull request into main that changes clusters/lab.yaml, open or already merged (merging
# early is fine: it only means the install has started).
n=""
for c in $(gitea_api GET "${REPO_PATH}/pulls?state=all&limit=50" | jq -r '[.[] | select(.base.ref=="main")] | sort_by(.number) | reverse | .[].number'); do
  gitea_api GET "${REPO_PATH}/pulls/$c/files" | jq -r '.[].filename' | grep -qx 'clusters/lab.yaml' && { n=$c; break; }
done
[[ -n "$n" ]] || { fail-message "No pull request changes clusters/lab.yaml yet. Edit the TMM node and enabled flag, push, and open the pull request (steps 2-3)."; exit 1; }
sha=$(gitea_api GET "${REPO_PATH}/pulls/$n" | jq -r .head.sha)
case "$(run_state plan.yml "$sha")" in
  completed/success) exit 0 ;;
  completed/*) fail-message "The plan for pull request #$n failed. Open it in Actions, read the last lines, fix clusters/lab.yaml, push again."; exit 1 ;;
  none) fail-message "No plan has run for pull request #$n yet. It starts when the pull request is opened; check Actions."; exit 1 ;;
  *) fail-message "The plan for pull request #$n is still running. Wait for it to finish (about a minute)."; exit 1 ;;
esac
