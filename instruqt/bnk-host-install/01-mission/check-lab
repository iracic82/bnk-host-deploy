#!/usr/bin/env bash
[ -n "${BASH_ENV:-}${ENV:-}" ] && echo "note: runner set BASH_ENV=${BASH_ENV:-} ENV=${ENV:-}, unset for child scripts" >&2
unset BASH_ENV ENV
set -uo pipefail
[[ -f /root/.lab/seen-status ]] || { fail-message "Run 'lab status' in the Terminal tab (step 5) and press Check again."; exit 1; }
exit 0
