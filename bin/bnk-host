#!/usr/bin/env bash
# bnk-host: the runner image's entrypoint. One verb per install phase, so an orchestrator (BNK Forge,
# a CI job, a person) can run and report the install step by step, with the same code install.sh runs.
#
#   bnk-host plan                 server-side dry run of the whole install
#   bnk-host install              every phase, in order
#   bnk-host <phase>              preflight | nodes | prereqs | registry | flo | certs |
#                                 cneinstance | license | ready | verify
#   bnk-host status               print the state of BNK on the cluster, write outputs.json
#   bnk-host uninstall            remove BNK (leaves cert-manager, Multus and Calico)
#
# Inputs, from the environment:
#   BNK_CLUSTER_FILE   a clusters/<name>.yaml to use as-is, or, to have one generated:
#     CLUSTER_NAME (default lab)  BNK_ENVIRONMENT (default lab)  TMM_NODE  STORAGE_CLASS
#   KUBECONFIG         default: $WORK/secrets/kubeconfig when present
#   FAR_PULL_JSON      default: $WORK/secrets/cne_pull_64.json
#   BNK_LICENSE_FILE   default: $WORK/secrets/license.jwt
#   WORK               the persistent workspace (Forge mounts it at /work)
set -euo pipefail
APP="${BNK_HOST_HOME:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
WORK="${WORK:-/work}"
mkdir -p "$WORK" 2>/dev/null || WORK="$(mktemp -d)"
export HOME="${HOME_OVERRIDE:-$WORK/.home}"; mkdir -p "$HOME"

# Who is running this, for the provenance stamp: an in-cluster Job is Argo CD's, otherwise Forge's.
if [[ -z "${BNK_ORCHESTRATOR:-}" ]]; then
  if [[ "${BNK_IN_CLUSTER:-false}" == "true" ]]; then export BNK_ORCHESTRATOR=argocd; else export BNK_ORCHESTRATOR=forge; fi
fi
[[ -z "${KUBECONFIG:-}" && -r "$WORK/secrets/kubeconfig" ]] && export KUBECONFIG="$WORK/secrets/kubeconfig"
[[ -z "${FAR_PULL_JSON:-}" && -r "$WORK/secrets/cne_pull_64.json" ]] && export FAR_PULL_JSON="$WORK/secrets/cne_pull_64.json"
[[ -z "${BNK_LICENSE_FILE:-}" && -r "$WORK/secrets/license.jwt" ]] && export BNK_LICENSE_FILE="$WORK/secrets/license.jwt"

cluster_file() {
  # Which cluster file to install from, in order:
  #   1. BNK_CLUSTER_FILE as given (the Argo CD Job mounts the repo's files from a ConfigMap)
  #   2. clusters/${CLUSTER_NAME}.yaml baked into this image, with its companion files
  #   3. a minimal file generated from the form inputs
  # With TMM_NODE set (Forge's form), the chosen file is copied to the workspace and its TMM node and
  # enabled flag are set from the form: the Forge form and the git file are the same contract.
  local name="${CLUSTER_NAME:-lab}" src="${BNK_CLUSTER_FILE:-}" dst
  [[ -z "$src" && -r "$APP/clusters/${name}.yaml" ]] && src="$APP/clusters/${name}.yaml"
  if [[ -n "$src" && -z "${TMM_NODE:-}" ]]; then printf '%s' "$src"; return; fi
  mkdir -p "$WORK/clusters"; dst="$WORK/clusters/${name}.yaml"
  if [[ -n "$src" ]]; then
    cp "$src" "$dst"
    for c in attachments network; do
      [[ -r "$(dirname "$src")/${name}.${c}.yaml" ]] && cp "$(dirname "$src")/${name}.${c}.yaml" "$WORK/clusters/"
    done
    TMM_NODE="$TMM_NODE" yq -i '.tmm.nodes = [strenv(TMM_NODE)] | .enabled = true | del(.kube_context)' "$dst"
    [[ -n "${BNK_ENVIRONMENT:-}" ]] && E="$BNK_ENVIRONMENT" yq -i '.environment = strenv(E)' "$dst"
    [[ -n "${STORAGE_CLASS:-}" ]] && S="$STORAGE_CLASS" yq -i '.storage_class = strenv(S)' "$dst"
  else
    : "${TMM_NODE:?TMM_NODE is required: the node TMM runs on}"
    cat > "$dst" <<EOF2
# generated by bnk-host from the deploy form
name: ${name}
environment: ${BNK_ENVIRONMENT:-lab}
storage_class: ${STORAGE_CLASS:-standard}
tmm:
  nodes: [${TMM_NODE}]
  manage_labels: true
enabled: true
EOF2
  fi
  printf '%s' "$dst"
}

phase() { "$APP/install.sh" --cluster "$(cluster_file)" --phase "$1"; }

write_outputs() {
  local ns_core=f5-cne-core ns_bnk=f5-bnk
  local avail lic tmm ver
  avail=$(kubectl get cneinstance -n $ns_bnk f5-bnk-instance -o jsonpath='{.status.conditions[?(@.type=="Available")].status}' 2>/dev/null || true)
  lic=$(kubectl get license.k8s.f5net.com -n $ns_core f5-cne-cluster-license -o jsonpath='{.status.state}' 2>/dev/null || true)
  tmm=$(kubectl get pods -n $ns_bnk -l app=f5-tmm -o jsonpath='{.items[0].spec.nodeName}' 2>/dev/null || true)
  ver=$(kubectl get cneinstance -n $ns_bnk f5-bnk-instance -o jsonpath='{.spec.manifestVersion}' 2>/dev/null || true)
  cat > "$WORK/outputs.json" <<EOF
{"cluster_name":"${CLUSTER_NAME:-lab}","bnk_manifest_version":"${ver:-none}","cneinstance_available":"${avail:-False}","license_state":"${lic:-none}","tmm_node":"${tmm:-none}","api_server":"$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null)"}
EOF
  cat "$WORK/outputs.json"; echo
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  plan)        "$APP/install.sh" --cluster "$(cluster_file)" --plan ;;
  install)     "$APP/install.sh" --cluster "$(cluster_file)"; write_outputs ;;
  preflight)   phase 00 ;;
  nodes)       phase 05 ;;
  prereqs)     phase 10 ;;
  registry)    phase 20 ;;
  flo)         phase 30 ;;
  certs)       phase 40 ;;
  cneinstance) phase 50 ;;
  license)     phase 60 ;;
  ready)       phase 65 ;;
  verify)      BNK_RECORD_PROVENANCE=true phase 70; write_outputs ;;
  status)      write_outputs ;;
  uninstall)   "$APP/uninstall.sh" "$@"; echo '{"cneinstance_available":"False","bnk_manifest_version":"none"}' > "$WORK/outputs.json" ;;
  version)     grep -E '^(BNK_VERSION|FLO_VERSION|CNE_RELEASE_MANIFEST)=' "$APP/versions.env" ;;
  help|-h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown command: $cmd (try: bnk-host help)" >&2; exit 2 ;;
esac
